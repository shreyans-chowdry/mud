# Run python3 scripts/init-local.py to create an ignored .env with random LOCAL secrets.
POSTGRES_PASSWORD=
# Optional Compose host port overrides; update MUD_DATABASE_URL for host tools if changed.
MUD_POSTGRES_PORT=5432
MUD_REDIS_PORT=6379
MUD_ENVIRONMENT=local
MUD_ELIGIBILITY_FILE=tests/fixtures/eligibility.local.json
MUD_CHAIN_ID=31337
MUD_RPC_HTTP=http://127.0.0.1:8545
MUD_RPC_WS=ws://127.0.0.1:8545
MUD_DATABASE_URL=postgresql+asyncpg://mud:REPLACE_WITH_GENERATED_LOCAL_PASSWORD@127.0.0.1:5432/mud
MUD_REDIS_URL=redis://127.0.0.1:6379/0
MUD_CONFIRMATIONS=1
MUD_FINALITY_DEPTH=3
MUD_START_BLOCK=0
MUD_BATCH_SIZE=100
MUD_RUN_WORKERS=false
MUD_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
MUD_WEBHOOK_URL=http://127.0.0.1:8001/fulfill
MUD_WEBHOOK_ALLOW_HOSTS=["127.0.0.1","localhost"]
MUD_WEBHOOK_SECRET=
# Testnet only: set each network-specific address after verifying official registries.
BASE_SEPOLIA_RPC=
ARBITRUM_SEPOLIA_RPC=
EXPECTED_CHAIN_ID=
PROTOCOL_OWNER=
PROTOCOL_GUARDIAN=
COLLATERAL_ADDRESS=
ORACLE_FEED=
SEQUENCER_FEED=
# Supply DEPLOYER_KEY through a secret manager / shell session; never commit it.
