# Copy to .env.production and fill privately in your hosting secret manager.
# Base mainnet configuration only; no deployment or signing is performed by this file.
MUD_ENVIRONMENT=production
MUD_CHAIN_ID=8453
MUD_RPC_HTTP=
MUD_RPC_WS=
MUD_DATABASE_URL=
MUD_REDIS_URL=
MUD_DEPLOYMENT_FILE=/app/deployments/8453.json
MUD_ELIGIBILITY_FILE=
MUD_CONFIRMATIONS=20
MUD_FINALITY_DEPTH=128
MUD_CORS_ORIGINS=[]
MUD_RUN_WORKERS=false
MUD_WEBHOOK_URL=
MUD_WEBHOOK_ALLOW_HOSTS=[]
MUD_WEBHOOK_SECRET=
# Frontend values are public and embedded during build. Never put signing secrets here.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_BASE_RPC=
NEXT_PUBLIC_ALLOW_TEST_NETWORKS=false
# Deployment-only settings: addresses are public; DEPLOYER_KEY belongs in a secure signer/session.
EXPECTED_CHAIN_ID=8453
BASE_RPC=
PROTOCOL_OWNER=
PROTOCOL_GUARDIAN=
COLLATERAL_ADDRESS=
ORACLE_FEED=
SEQUENCER_FEED=
ORACLE_MAX_AGE=
MERKLE_FILE=
