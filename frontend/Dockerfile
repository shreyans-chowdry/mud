FROM node:22.23.3-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends python3 build-essential && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend ./
ARG NEXT_PUBLIC_API_URL=
ARG NEXT_PUBLIC_LOCAL_RPC=http://127.0.0.1:8545
ARG NEXT_PUBLIC_BASE_RPC=
ARG NEXT_PUBLIC_BASE_SEPOLIA_RPC=
ARG NEXT_PUBLIC_ARBITRUM_RPC=
ARG NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC=
ARG NEXT_PUBLIC_ALLOW_TEST_NETWORKS=false
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL NEXT_PUBLIC_LOCAL_RPC=$NEXT_PUBLIC_LOCAL_RPC NEXT_PUBLIC_BASE_RPC=$NEXT_PUBLIC_BASE_RPC NEXT_PUBLIC_BASE_SEPOLIA_RPC=$NEXT_PUBLIC_BASE_SEPOLIA_RPC NEXT_PUBLIC_ARBITRUM_RPC=$NEXT_PUBLIC_ARBITRUM_RPC NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC=$NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC NEXT_PUBLIC_ALLOW_TEST_NETWORKS=$NEXT_PUBLIC_ALLOW_TEST_NETWORKS NEXT_TELEMETRY_DISABLED=1
RUN npm run build
FROM node:22.23.3-bookworm-slim
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
COPY --from=build --chown=node:node /app ./
USER node
EXPOSE 3000
CMD ["npm", "start"]
