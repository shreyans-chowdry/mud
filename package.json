{
  "name": "mud-protocol",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "compile": "node scripts/hardhat.cjs compile && node scripts/export-abi.cjs",
    "test:contracts": "node scripts/hardhat.cjs test",
    "coverage:contracts": "node scripts/hardhat.cjs coverage",
    "chain": "node scripts/hardhat.cjs node --hostname 0.0.0.0",
    "deploy:local": "node scripts/hardhat.cjs run contracts/script/deploy.cjs --network localhost",
    "lifecycle": "node scripts/hardhat.cjs run scripts/lifecycle.cjs --network localhost",
    "test": "npm run test:contracts && npm --prefix frontend test && backend/.venv/bin/python -m pytest backend/tests",
    "manifest": "python3 scripts/manifest.py"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "3.1.0",
    "@nomicfoundation/hardhat-chai-matchers": "2.1.0",
    "@openzeppelin/contracts": "5.0.2",
    "chai": "4.5.0",
    "ethers": "6.14.4",
    "fast-check": "4.2.0",
    "hardhat": "2.29.1",
    "solc": "0.8.24",
    "solidity-coverage": "0.8.16"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "tmp": "0.2.7",
    "ws": "8.22.0",
    "@fastify/busboy": "3.2.2",
    "serialize-javascript": "7.0.5",
    "undici": "6.28.1"
  }
}
